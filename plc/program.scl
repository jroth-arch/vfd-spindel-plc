DATA_BLOCK "DB_Config"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		TempHighThreshold_C : Real;   // prahova teplota alarmu [degC] – default 65.0
		VibCriticalThreshold : Real;  // prahova hodnota vibraci – default 0.0 (senzor nezapojen)
		DAC_MaxDacRange : Int;        // max hodnota DAC pro 10V (S7-1200) – default 27648
		InputSim : Struct
			EnableSafetyRelayAuxOverride : Bool;   // SIM: TRUE = pouzij SafetyRelayAuxOk misto fyzickeho DI0
			SafetyRelayAuxOk : Bool;               // SIM default TRUE – simuluje OK safety rele (PermitMotion=TRUE)
			EnableEmergencyStopOverride : Bool;    // SIM: TRUE = pouzij EmergencyStop misto fyzickeho DI1
			EmergencyStop : Bool;                  // SIM default FALSE – simuluje uvolneny E-Stop (bez tripu)
			EnableRPM_Sim : Bool;                  // SIM: TRUE = pouzij SimRPM misto TM_Counter
			SimRPM : Real;                         // SIM default 12000.0 RPM (max 18000)
			EnableTempLozisko_Sim : Bool;          // SIM: TRUE = pouzij SimTempLozisko_C misto AI1_RTD
			SimTempLozisko_C : Real;               // SIM default 35.0 degC (alarm >65 degC)
			EnableTempKartace_Sim : Bool;          // SIM: TRUE = pouzij SimTempKartace_C misto AI2_RTD
			SimTempKartace_C : Real;               // SIM default 40.0 degC (alarm >65 degC)
		END_STRUCT;
	END_VAR

BEGIN
	TempHighThreshold_C := 65.0;
	VibCriticalThreshold := 0.0;
	DAC_MaxDacRange := 27648;
	InputSim.EnableSafetyRelayAuxOverride := false;
	InputSim.SafetyRelayAuxOk := true;
	InputSim.EnableEmergencyStopOverride := false;
	InputSim.EmergencyStop := false;
	InputSim.EnableRPM_Sim := false;
	InputSim.SimRPM := 12000.0;
	InputSim.EnableTempLozisko_Sim := false;
	InputSim.SimTempLozisko_C := 35.0;
	InputSim.EnableTempKartace_Sim := false;
	InputSim.SimTempKartace_C := 40.0;

END_DATA_BLOCK

FUNCTION "FC_ConvertIO" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	IF "DB_Config".InputSim.EnableTempLozisko_Sim THEN
		"DB_HMI".Sensors.AI1_Teplota_Lozisko_C := "DB_Config".InputSim.SimTempLozisko_C;
	ELSE
		"DB_HMI".Sensors.AI1_Teplota_Lozisko_C := "DB_IO".AI.AI1_TeplotaLoziska_Ohm / 10.0;
	END_IF;
	IF "DB_Config".InputSim.EnableTempKartace_Sim THEN
		"DB_HMI".Sensors.AI2_Teplota_Kartace_C := "DB_Config".InputSim.SimTempKartace_C;
	ELSE
		"DB_HMI".Sensors.AI2_Teplota_Kartace_C := "DB_IO".AI.AI2_TeplotaKartace_Ohm / 10.0;
	END_IF;
	IF "DB_Config".InputSim.EnableRPM_Sim THEN
		"DB_HMI".Sensors.TM_Rotation_A_Channel := "DB_Config".InputSim.SimRPM;
	ELSE
		"DB_HMI".Sensors.TM_Rotation_A_Channel := ("DB_IO".TM.MeasuredValue * 60) / 2;
	END_IF;
END_FUNCTION

FUNCTION "FC_IO_Map_Write" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	"AQ0" := REAL_TO_INT("DB_IO".AQ.SpeedVoltage / 10.0 * 27648.0);
	"AQ1" := REAL_TO_INT("DB_IO".AQ.AQ1_CurrentCtrl_V / 10.0 * 27648.0);
	"AQ2" := REAL_TO_INT("DB_IO".AQ.AQ2_VoltageCtrl_V / 10.0 * 27648.0);
	"AQ3" := REAL_TO_INT("DB_IO".AQ.AQ3_OutputOff / 10.0 * 27648.0);
	
	"DQ0_MI1_Run_Forward" := "DB_IO".DQ.RunForwardCmd;
	"DQ1_Reset_Button_Blue_LED" := "DB_IO".DQ.ResetButtonLed;
	"DQ2_Stop_Button_Red_Led" := "DB_IO".DQ.EmergencyStopButtonLed;
END_FUNCTION

FUNCTION "FC_IO_Map_Read" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	IF "DB_Config".InputSim.EnableSafetyRelayAuxOverride THEN
		"DB_IO".DI.SafetyRelayAuxOk := "DB_Config".InputSim.SafetyRelayAuxOk;
	ELSE
		"DB_IO".DI.SafetyRelayAuxOk := "DI0_SafetyRelay_Aux";
	END_IF;
	IF "DB_Config".InputSim.EnableEmergencyStopOverride THEN
		"DB_IO".DI.EmergencyStop := "DB_Config".InputSim.EmergencyStop;
	ELSE
		"DB_IO".DI.EmergencyStop := NOT "DI1_SafetyRelay_Released_Safety_Button"; // DI1_SafetyRelay_Released_Safety_Button = False znamena, ze mame stisknuty safety button, ktery je normally closed a po stisknuti se kontakt rozpoji a na vstupu je 0V
	END_IF;
	"DB_IO".AI.AI1_TeplotaLoziska_Ohm := "AI1_RTD";
	"DB_IO".AI.AI2_TeplotaKartace_Ohm := "AI2_RTD";
END_FUNCTION

