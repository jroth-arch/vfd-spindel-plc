FUNCTION_BLOCK "FB_DriveCtrl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      HMI_Start : Bool := false;   // start command (button)
      HMI_Stop : Bool := false;   // stop command (button)
      HMI_ResetFault : Bool := false;   // reset fault (button)
      HMI_Speed_RPM : Real := 0.0;   // speed setpoint in RPM Interlocks / safety
      PermitMotion : Bool := false;   // from safety gate
      EmergencyStop : Bool := false;   // E-Stop chain
      ExternalFaultIn : Bool := false;   // external fault input Parameters
      SpeedMax_RPM : Real := 18000.0;   // max RPM corresponds to 10V
      AO_MaxVolt : Real := 10.0;   // 0..10V
      RampUp_RPM_per_s : Real := 6000.0;   // ramp up rate
      RampDown_RPM_per_s : Real := 9000.0;   // ramp down rate
      ResetPulse : Time := T#300MS;   // reset pulse length
      RequireSpeedToRun : Bool := FALSE;   // if TRUE, Start only latches when setpoint > 0 Outputs to drive
   END_VAR

   VAR_OUTPUT 
      DO_RunForward : Bool := false;
      DO_FaultReset : Bool := false;
      DO_MultiSpeed1 : Bool := false;
      DO_ExternalFault : Bool := false;
      AQ1_Voltage_0_10V : Real := 0.0;   // Status for HMI/diagnostics
      RunLatched : Bool := false;   // internal run request latch
      TripActive : Bool := false;   // interlock active
      State : USInt := 0;   // 0 STOPPED, 1 RUN_CMD, 2 STOPPING, 3 TRIP
      StatusText : String[40] := '';   // Edge detection
   END_VAR

   VAR 
      prevStart : Bool := false;
      prevStop : Bool := false;
      prevReset : Bool := false;
      startEdge : Bool := false;
      stopEdge : Bool := false;
      resetEdge : Bool := false;   // Ramp variables
      speedCmdRPM : Real := 0.0;
      speedRampRPM : Real := 0.0;   // Reset pulse timer
      tReset {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;   // Cycle time assumption (OB1). Use OB35 for precise timing if needed.
      cycle_s { S7_SetPoint := 'True'} : Real := 0.01;   // 10 ms default
   END_VAR


BEGIN
	    // ------------------------------------------------------------
	    // Edge detection for Start/Stop/Reset
	    // ------------------------------------------------------------
	    #startEdge := #HMI_Start AND NOT #prevStart;
	    #stopEdge := #HMI_Stop AND NOT #prevStop;
	    #resetEdge := #HMI_ResetFault AND NOT #prevReset;
	    
	    #prevStart := #HMI_Start;
	    #prevStop := #HMI_Stop;
	    #prevReset := #HMI_ResetFault;
	    
	    // ------------------------------------------------------------
	    // Trip / interlock
	    // Trip znamena zakaz běhu vřetene, pokud není splněna bezpečnostní podmínka. Trip = okamžité odstavení zařízení.
	    // ------------------------------------------------------------
	    #TripActive := (NOT #PermitMotion) OR #EmergencyStop OR #ExternalFaultIn;
	    
	    // External fault output to the drive (if wired this way)
	    #DO_ExternalFault := #TripActive;
	    
	    // ------------------------------------------------------------
	    // Sanitize setpoint
	    // Sanitize = zkontrolovat a upravit vstupní hodnotu tak, aby byla bezpečná a platná.
	    // ------------------------------------------------------------
	    #speedCmdRPM := #HMI_Speed_RPM;
	    IF #speedCmdRPM < 0.0 THEN
	        #speedCmdRPM := 0.0;
	    END_IF;
	    IF #speedCmdRPM > #SpeedMax_RPM THEN
	        #speedCmdRPM := #SpeedMax_RPM;
	    END_IF;
	    
	    // ------------------------------------------------------------
	    // Run latch logic (Stop has priority)
	    // ------------------------------------------------------------
	    IF #TripActive THEN
	        #RunLatched := FALSE;
	    ELSE
	        IF #stopEdge OR #HMI_Stop THEN
	            #RunLatched := FALSE;
	        ELSIF #startEdge THEN
	            IF (NOT #RequireSpeedToRun) OR (#speedCmdRPM > 0.0) THEN
	                #RunLatched := TRUE;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ------------------------------------------------------------
	    // Fault reset pulse (recommended only when not running)
	    // ------------------------------------------------------------
	    #tReset(IN := (#resetEdge AND NOT #TripActive AND NOT #RunLatched),
	            PT := #ResetPulse);
	    #DO_FaultReset := #tReset.Q;
	    
	    // ------------------------------------------------------------
	    // Defaults
	    // ------------------------------------------------------------
	    #DO_MultiSpeed1 := FALSE;
	    
	    // ------------------------------------------------------------
	    // State (for HMI readability; no drive feedback available)
	    // ------------------------------------------------------------
	    IF #TripActive THEN
	        #State := 3; // TRIP
	    ELSE
	        IF #RunLatched THEN
	            #State := 1; // RUN_CMD
	        ELSE
	            IF #speedRampRPM > 0.0 THEN
	                #State := 2; // STOPPING (ramp down)
	            ELSE
	                #State := 0; // STOPPED
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    CASE #State OF
	        0:
	            #StatusText := 'STOPPED';
	        1:
	            #StatusText := 'RUN CMD (no feedback)';
	        2:
	            #StatusText := 'STOPPING (ramp down)';
	        3:
	            #StatusText := 'TRIP (E-Stop/Interlock)';
	        ELSE
	            #StatusText := 'UNKNOWN';
	    END_CASE;
	    
	    // ------------------------------------------------------------
	    // Drive command + speed ramp
	    // ------------------------------------------------------------
	    IF #TripActive THEN
	        #DO_RunForward := FALSE;
	        #speedRampRPM := 0.0;
	    ELSE
	        IF #RunLatched THEN
	            #DO_RunForward := TRUE;
	            
	            // Ramp toward setpoint (up & down)
	            IF #speedRampRPM < #speedCmdRPM THEN
	                #speedRampRPM := #speedRampRPM + (#RampUp_RPM_per_s * #cycle_s);
	                IF #speedRampRPM > #speedCmdRPM THEN
	                    #speedRampRPM := #speedCmdRPM;
	                END_IF;
	            ELSIF #speedRampRPM > #speedCmdRPM THEN
	                #speedRampRPM := #speedRampRPM - (#RampDown_RPM_per_s * #cycle_s);
	                IF #speedRampRPM < #speedCmdRPM THEN
	                    #speedRampRPM := #speedCmdRPM;
	                END_IF;
	            END_IF;
	            
	        ELSE
	            #DO_RunForward := FALSE;
	            
	            // Ramp down to 0
	            IF #speedRampRPM > 0.0 THEN
	                #speedRampRPM := #speedRampRPM - (#RampDown_RPM_per_s * #cycle_s);
	                IF #speedRampRPM < 0.0 THEN
	                    #speedRampRPM := 0.0;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ------------------------------------------------------------
	    // RPM -> 0..10V conversion
	    // ------------------------------------------------------------
	    IF #SpeedMax_RPM > 0.0 THEN
	        #AQ1_Voltage_0_10V := (#speedRampRPM / #SpeedMax_RPM) * #AO_MaxVolt;
	    ELSE
	        #AQ1_Voltage_0_10V := 0.0;
	    END_IF;
	    
	    // ------------------------------------------------------------
	    // Clamp AO (Clamp znamena omezit hodnotu tak, aby zůstala v daném rozsahu (min–max))
	    //  ------------------------------------------------------------
	    IF #AQ1_Voltage_0_10V < 0.0 THEN
	        #AQ1_Voltage_0_10V := 0.0;
	    END_IF;
	    IF #AQ1_Voltage_0_10V > #AO_MaxVolt THEN
	        #AQ1_Voltage_0_10V := #AO_MaxVolt;
	    END_IF;
	    
	    // Hard safety
	    IF #TripActive THEN
	        #AQ1_Voltage_0_10V := 0.0;
	    END_IF;
	    
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_SafetyButtons"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      DI0_AuxSafetyRelay : Bool;   // AUX ze safety relé
      DI1_SafetyButton : Bool;   // signal ze safety tlačítka
   END_VAR

   VAR_OUTPUT 
      DQ1_LED : Bool;   // Cervene LED svetlo na STOP tlacitku
      DQ0_LED : Bool;   // Modre LED reset svetlo
   END_VAR


BEGIN
	// Bezpečný default
	#DQ1_LED := FALSE;
	#DQ0_LED := FALSE;
	
	// Vyhodnocení kombinací
	IF (NOT #DI0_AuxSafetyRelay) AND (#DI1_SafetyButton) THEN
	    // DI0 = 0, DI1 = 0
	    #DQ1_LED := TRUE;
	    #DQ0_LED := FALSE;
	    
	ELSIF (NOT #DI0_AuxSafetyRelay) AND (NOT #DI1_SafetyButton) THEN
	    // DI0 = 0, DI1 = 1
	    #DQ1_LED := FALSE;
	    #DQ0_LED := TRUE;
	    
	ELSIF #DI0_AuxSafetyRelay AND (NOT #DI1_SafetyButton) THEN
	    // DI0 = 1, DI1 = 1
	    #DQ1_LED := FALSE;
	    #DQ0_LED := FALSE;
	    
	ELSE
		// DI0 = 1, DI1_SafetyButton = true -> relay OK, button stisknuty = E-STOP fault stav
		// cervena LED sviti
		#DQ1_LED := TRUE;  
		#DQ0_LED := FALSE;
	END_IF;
END_FUNCTION_BLOCK

