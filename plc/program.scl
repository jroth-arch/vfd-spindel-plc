// --- LOGGING FUNCTION BLOCK ---
// Volani:
//   OB30 (100ms): LogManager.SampleStep()   - plni buffer kazdych SampleEveryN_Cycles cyklu
//   Main (OB1):   LogManager.FlushPending   - zkontroluj flag a zapis na SD
FUNCTION_BLOCK "FB_LogManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT
		Enable : Bool;
		StartTest : Bool;
		StopTest : Bool;
		RPM : Real;
		T_Lozisko : Real;
		T_Uhliky : Real;
		Vibrace : Real;
		ProudUhliky : Real;
		State : USInt;
		RunLatched : Bool;
		TripActive : Bool;
		TripCode : USInt;
		SafetyText : String[40];
		// SampleEveryN_Cycles: kolikrat se OB30 zavola nez se ulozi 1 vzorek
		// Pr.: OB30 = 100ms, SampleEveryN = 2 -> vzorkovani 200ms
		SampleEveryN_Cycles : Int := 2;
		TestDuration_s : DInt := 86400;
		FlushEveryN : Int := 100;
		AckFlush : Bool;   // vstup od FB_LogFlushToSd – potvrzeni flushe, resetuje FlushPending
	END_VAR

	VAR_OUTPUT
		FlushPending : Bool;       // TRUE = buffer ma dost dat -> Main muze zapsat na SD
		TestTimeoutReached : Bool; // TRUE = test uplynul
	END_VAR

	VAR
		prevStartTest : Bool := FALSE;
		prevStopTest : Bool := FALSE;
		prevAckFlush : Bool := FALSE;
		cycleCounter : Int := 0;
		flushCounter : Int := 0;
	END_VAR

	VAR_TEMP
		startDtl  : DTL;
		rdRet     : Int;
		mo2       : String[2];
		dy2       : String[2];
		hr2       : String[2];
		mn2       : String[2];
		sc2       : String[2];
	END_VAR

BEGIN
	// Detekce startu testu (hrana)
	IF Enable AND (StartTest AND NOT prevStartTest) THEN
		"DB_LogRuntime".TestActive := TRUE;
		"DB_LogRuntime".Elapsed_s := 0.0;
		"DB_LogRuntime".SampleCounter := 0;
		"DB_LogRuntime".FlushErrorCount := 0;
		"DB_LogRuntime".LastFlushOk := TRUE;
		"DB_LogRuntime".HeaderWritten := FALSE;
		"DB_LogBuffer".TrendWriteIdx := 0;
		"DB_LogBuffer".TrendReadIdx := 0;
		cycleCounter := 0;
		flushCounter := 0;
		FlushPending := FALSE;
		TestTimeoutReached := FALSE;

		// Generovani nazvu souboru z aktualniho casu (YYYYMMDD-HHMMSS.csv)
		rdRet := RD_SYS_T(OUT := startDtl);
		mo2 := USINT_TO_STRING(startDtl.MONTH);
		IF startDtl.MONTH < 10 THEN
			mo2 := CONCAT(IN1 := '0', IN2 := mo2);
		END_IF;

		dy2 := USINT_TO_STRING(startDtl.DAY);
		IF startDtl.DAY < 10 THEN
			dy2 := CONCAT(IN1 := '0', IN2 := dy2);
		END_IF;

		hr2 := USINT_TO_STRING(startDtl.HOUR);
		IF startDtl.HOUR < 10 THEN
			hr2 := CONCAT(IN1 := '0', IN2 := hr2);
		END_IF;

		mn2 := USINT_TO_STRING(startDtl.MINUTE);
		IF startDtl.MINUTE < 10 THEN
			mn2 := CONCAT(IN1 := '0', IN2 := mn2);
		END_IF;

		sc2 := USINT_TO_STRING(startDtl.SECOND);
		IF startDtl.SECOND < 10 THEN
			sc2 := CONCAT(IN1 := '0', IN2 := sc2);
		END_IF;

		"DB_LogRuntime".FileName := UINT_TO_STRING(startDtl.YEAR);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := mo2);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := dy2);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := '-');
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := hr2);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := mn2);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := sc2);
		"DB_LogRuntime".FileName := CONCAT(IN1 := "DB_LogRuntime".FileName, IN2 := '.csv');
		"DB_LogRuntime".HeaderWritten := FALSE;
		"DB_LogRuntime".FlushErrorCount := 0;
		"DB_LogRuntime".LastFlushOk := TRUE;
		// (event log: TEST_START)
	END_IF;

	// Detekce stopu testu (hrana)
	IF Enable AND (StopTest AND NOT prevStopTest) THEN
		"DB_LogRuntime".TestActive := FALSE;
		FlushPending := TRUE;   // finalni flush pri manuálním stopu
		// (event log: TEST_STOP)
	END_IF;

	prevStartTest := StartTest;
	prevStopTest := StopTest;

	// Handshake: FB_LogFlushToSd potvrdil flush -> resetovat FlushPending
	IF AckFlush AND NOT prevAckFlush THEN
		FlushPending := FALSE;
	END_IF;
	prevAckFlush := AckFlush;

	// Cyklické vzorkování pouze pokud test běží
	IF Enable AND "DB_LogRuntime".TestActive THEN
		cycleCounter := cycleCounter + 1;

		IF cycleCounter >= SampleEveryN_Cycles THEN
			cycleCounter := 0;

			// Cas od startu: kazdy vzorek = SampleEveryN * 0.1s (OB30 period)
			"DB_LogRuntime".Elapsed_s := "DB_LogRuntime".Elapsed_s
				+ (INT_TO_REAL(SampleEveryN_Cycles) * 0.1);

			// Zapis vzorku do kruhoveho bufferu
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].t_s := "DB_LogRuntime".Elapsed_s;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RPM := RPM;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Lozisko := T_Lozisko;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Uhliky := T_Uhliky;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].Vibrace := Vibrace;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].ProudUhliky := ProudUhliky;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].State := State;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RunLatched := RunLatched;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripActive := TripActive;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripCode := TripCode;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].SafetyText := SafetyText;

			// Posun indexu (kruhový buffer)
			"DB_LogBuffer".TrendWriteIdx := "DB_LogBuffer".TrendWriteIdx + 1;
			IF "DB_LogBuffer".TrendWriteIdx > 999 THEN
				"DB_LogBuffer".TrendWriteIdx := 0;
			END_IF;
			"DB_LogRuntime".SampleCounter := "DB_LogRuntime".SampleCounter + 1;

			// FlushPending: Main vi, ze je cas zapsat na SD
			flushCounter := flushCounter + 1;
			IF flushCounter >= FlushEveryN THEN
				flushCounter := 0;
				FlushPending := TRUE;
			END_IF;
		END_IF;

		// Konec testu po uplynutí času
		IF "DB_LogRuntime".Elapsed_s >= DINT_TO_REAL(TestDuration_s) THEN
			"DB_LogRuntime".TestActive := FALSE;
			TestTimeoutReached := TRUE;
			FlushPending := TRUE;   // posledni flush
			// (event log: TEST_END_TIMEOUT)
		END_IF;
	END_IF;
END_FUNCTION_BLOCK
TYPE "UDT_SENSORS"
VERSION : 0.1
   STRUCT
      AI1_Teplota_Lozisko_C : Real;
      TM_Rotation_A_Channel : Real;
   END_STRUCT;


END_TYPE

