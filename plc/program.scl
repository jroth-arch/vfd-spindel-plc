FUNCTION_BLOCK "FB_SafetyGate"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool;   // hlavní povolení systému
      EmergencyStop : Bool;   // 1 = E-Stop aktivní
      SafetyRelayAuxOk : Bool;   // 1 = safety relé OK
      ExternalFault : Bool;   // 1 = externí chyba
      TempAlarm : Bool;   // 1 = kritická teplota
      VibAlarm : Bool;   // 1 = kritické vibrace
   END_VAR

   VAR_OUTPUT 
      SafetyOk : Bool;
      PermitMotion : Bool;
      TripActive : Bool;
      TripCode : USInt;
      StatusText : String[40];
   END_VAR


BEGIN
	// hardware safety stav
	#SafetyOk := #SafetyRelayAuxOk AND NOT #EmergencyStop;
	
	// centrální trip
	#TripActive := (NOT #SafetyOk) OR #ExternalFault OR #TempAlarm OR #VibAlarm OR (NOT #Enable);
	
	// povolení pohybu
	#PermitMotion := NOT #TripActive;
	
	// diagnostika
	IF #EmergencyStop THEN
	    #TripCode := 1;
	    #StatusText := 'E-STOP ACTIVE';
	ELSIF NOT #SafetyRelayAuxOk THEN
	    #TripCode := 2;
	    #StatusText := 'SAFETY RELAY NOT OK';
	ELSIF #ExternalFault THEN
	    #TripCode := 3;
	    #StatusText := 'EXTERNAL FAULT';
	ELSIF #TempAlarm THEN
	    #TripCode := 4;
	    #StatusText := 'TEMP ALARM';
	ELSIF #VibAlarm THEN
	    #TripCode := 5;
	    #StatusText := 'VIBRATION ALARM';
	ELSIF NOT #Enable THEN
	    #TripCode := 6;
	    #StatusText := 'SYSTEM NOT ENABLED';
	ELSE
	    #TripCode := 0;
	    #StatusText := 'READY';
	END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_LabPSU"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool := false;   // povolenÃ­ funkce z PLC/HMI
      PermitOutput : Bool := false;   // interlock / safety gate
      Mode : USInt := 0;   // 0=OFF, 1=CONST, 2=SINE_DEBUG ÄasovÃ¡ zÃ¡kladna
      Cycle_s : Real := 0.01;   // typicky OB35 = 10 ms zdroj - zÃ¡kladnÃ­ nastavenÃ­
      BaseVoltage_V : Real := 1.0;   // AQ2
      CurrentOffset_A : Real := 0.0;   // DC offset proudu
      DebugAmplitude_A : Real := 60.0;   // amplituda sinu pro debug
      DebugFrequency_Hz : Real := 2.0;   // frekvence sinu pro debug konstantnÃ­ reÅ¾im
      ConstCurrent_A : Real := 10.0;   // rampy
      RampUp_A_per_s : Real := 50.0;
      RampDown_A_per_s : Real := 80.0;   // parametry zdroje BK1900B
	PSU_MinVoltage_V : Real := 0.8;   // minimalni napeti pro stabilni vystup zdroje
      PSU_MaxVoltage_V : Real := 16.0;   // model 1900B
      PSU_MaxCurrent_A : Real := 60.0;   // model 1900B
      RemoteMaxCtrl_V : Real := 5.0;   // analog remote 0..5 V engineering outputs
   END_VAR

   VAR_OUTPUT 
      VoltageSet_V : Real := 0.0;   // poÅ¾adovanÃ© napÄ›tÃ­ zdroje
      CurrentSet_A : Real := 0.0;   // poÅ¾adovanÃ½ current limit analog outputs for PLC IO layer
      AQ2_VoltageCtrl_V : Real := 0.0;   // 0..5 V na pin 2
      AQ3_CurrentCtrl_V : Real := 0.0;   // 0..5 V na pin 3 digital output for pin 5
	AQ_OutputOff_V : Real := 5.0;   // 0.0 V = enable, 5.0 V = output off
      State : USInt := 0;   // 0 OFF, 1 CONST, 2 SINE
      StatusText : String[40] := '';
   END_VAR

   VAR 
      phase_rad : Real := 0.0;
      omega : Real := 0.0;
      targetCurrent_A : Real := 0.0;
      sineValue : Real := 0.0;
	effectiveOffset_A : Real := 0.0;
	offsetAutoAdjusted : Bool := FALSE;
   END_VAR


BEGIN
	// safety / permit
	IF (NOT #Enable) OR (NOT #PermitOutput) THEN
	    #phase_rad := 0.0;
	    #VoltageSet_V := 0.0;
	    #CurrentSet_A := 0.0;
	    #AQ2_VoltageCtrl_V := 0.0;
	    #AQ3_CurrentCtrl_V := 0.0;
	    #AQ_OutputOff_V := 5.0;
	    #State := 0;
	    #StatusText := 'SAFE OFF';
	    RETURN;
	END_IF;
	
	// vystup zdroje povolen
	#AQ_OutputOff_V := 0.0;
	
	// zakladni napeti
	#VoltageSet_V := #BaseVoltage_V;
	
	// omezeni napeti
	IF #VoltageSet_V < #PSU_MinVoltage_V THEN
	    #VoltageSet_V := #PSU_MinVoltage_V;
	END_IF;
	IF #VoltageSet_V > #PSU_MaxVoltage_V THEN
	    #VoltageSet_V := #PSU_MaxVoltage_V;
	END_IF;
	
	CASE #Mode OF
	    0: // OFF
	        #CurrentSet_A := 0.0;
	        #VoltageSet_V := 0.0;
	        #AQ_OutputOff_V := 5.0;
	        #State := 0;
	        #StatusText := 'OFF';
	        
	    1: // CONST
	        #targetCurrent_A := #ConstCurrent_A;
	        
	        IF #targetCurrent_A < 0.0 THEN
	            #targetCurrent_A := 0.0;
	        END_IF;
	        IF #targetCurrent_A > #PSU_MaxCurrent_A THEN
	            #targetCurrent_A := #PSU_MaxCurrent_A;
	        END_IF;
	        
	        // jednoducha rampa
	        IF #CurrentSet_A < #targetCurrent_A THEN
	            #CurrentSet_A := #CurrentSet_A + (#RampUp_A_per_s * #Cycle_s);
	            IF #CurrentSet_A > #targetCurrent_A THEN
	                #CurrentSet_A := #targetCurrent_A;
	            END_IF;
	        ELSIF #CurrentSet_A > #targetCurrent_A THEN
	            #CurrentSet_A := #CurrentSet_A - (#RampDown_A_per_s * #Cycle_s);
	            IF #CurrentSet_A < #targetCurrent_A THEN
	                #CurrentSet_A := #targetCurrent_A;
	            END_IF;
	        END_IF;
	        
	        #State := 1;
	        #StatusText := 'CONST';
	        
	    2: // SINE_DEBUG
	        #omega := 6.2831853 * #DebugFrequency_Hz; // 2*pi*f
	        #offsetAutoAdjusted := FALSE;
	        
	        #phase_rad := #phase_rad + (#omega * #Cycle_s);
	        
	        // drzet fazi v rozumnem rozsahu
	        IF #phase_rad > 6.2831853 THEN
	            #phase_rad := #phase_rad - 6.2831853;
	        END_IF;
	        
	        #sineValue := SIN(#phase_rad);
	        
	        // sinus s offsetem
	        #effectiveOffset_A := #CurrentOffset_A;
	        IF #effectiveOffset_A < #DebugAmplitude_A THEN
	            #effectiveOffset_A := #DebugAmplitude_A;
	            #offsetAutoAdjusted := TRUE;
	        END_IF;
	        #targetCurrent_A := #effectiveOffset_A + (#DebugAmplitude_A * #sineValue);
	        // current limit zdroje nemuze byt zaporny
	        IF #targetCurrent_A < 0.0 THEN
	            #targetCurrent_A := 0.0;
	        END_IF;
	        
	        IF #targetCurrent_A > #PSU_MaxCurrent_A THEN
	            #targetCurrent_A := #PSU_MaxCurrent_A;
	        END_IF;
	        
	        // volitelne muzes i tady nechat rampu, ale pro sinus ji vetsinou nechces moc agresivni
	        #CurrentSet_A := #targetCurrent_A;
	        
	        #State := 2;
	        IF #offsetAutoAdjusted THEN
	            #StatusText := 'SINE DEBUG (AUTO OFFSET)';
	        ELSE
	            #StatusText := 'SINE DEBUG';
	        END_IF;
	        
	    ELSE
	        #CurrentSet_A := 0.0;
	        #VoltageSet_V := 0.0;
	        #AQ_OutputOff_V := 5.0;
	        #State := 0;
	        #StatusText := 'UNKNOWN->OFF';
	END_CASE;
	
	// prevod engineering units -> BK remote control 0..5V
	
	// napeti
	IF #PSU_MaxVoltage_V > 0.0 THEN
	    #AQ2_VoltageCtrl_V := (#VoltageSet_V / #PSU_MaxVoltage_V) * #RemoteMaxCtrl_V;
	ELSE
	    #AQ2_VoltageCtrl_V := 0.0;
	END_IF;
	
	// proud
	IF #PSU_MaxCurrent_A > 0.0 THEN
	    #AQ3_CurrentCtrl_V := (#CurrentSet_A / #PSU_MaxCurrent_A) * #RemoteMaxCtrl_V;
	ELSE
	    #AQ3_CurrentCtrl_V := 0.0;
	END_IF;
	
	// clamp
	IF #AQ2_VoltageCtrl_V < 0.0 THEN
	    #AQ2_VoltageCtrl_V := 0.0;
	END_IF;
	IF #AQ2_VoltageCtrl_V > #RemoteMaxCtrl_V THEN
	    #AQ2_VoltageCtrl_V := #RemoteMaxCtrl_V;
	END_IF;
	
	IF #AQ3_CurrentCtrl_V < 0.0 THEN
	    #AQ3_CurrentCtrl_V := 0.0;
	END_IF;
	IF #AQ3_CurrentCtrl_V > #RemoteMaxCtrl_V THEN
	    #AQ3_CurrentCtrl_V := #RemoteMaxCtrl_V;
	END_IF;
	
END_FUNCTION_BLOCK

