ORGANIZATION_BLOCK "TimeSensitive"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      NormValue : Real;
      ScaledValue : UInt;
   END_VAR

   VAR CONSTANT 
      PI : Real := 3.141593;
   END_VAR


BEGIN
	"LabPSU"(Enable := "DB_HMI".LabPSU.Enable,
	         PermitOutput := "DB_Status".Safety.PermitMotion,
	         Mode := "DB_HMI".LabPSU.Mode,
	         Cycle_s := "DB_HMI".LabPSU.Cycle_s,
	         BaseVoltage_V := "DB_HMI".LabPSU.BaseVoltage_V,
	         CurrentOffset_A := "DB_HMI".LabPSU.CurrentOffset_A,
	         DebugAmplitude_A := "DB_HMI".LabPSU.DebugAmplitude_A,
	         DebugFrequency_Hz := "DB_HMI".LabPSU.DebugFrequency_Hz,
	         ConstCurrent_A := "DB_HMI".LabPSU.ConstCurrent_A,
	         RampUp_A_per_s := 50.0,
	         RampDown_A_per_s := 80.0,
	         PSU_MinVoltage_V := 0.8,
	         PSU_MaxVoltage_V := 16.0,
	         PSU_MaxCurrent_A := 60.0,
	         RemoteMaxCtrl_V := 5.0,
	         VoltageSet_V => "DB_Status".LabPSU.VoltageSet_V,
	         CurrentSet_A => "DB_Status".LabPSU.CurrentSet_A,
	         AQ2_VoltageCtrl_V => "DB_IO".AQ.AQ2_VoltageCtrl_V,
	         AQ3_CurrentCtrl_V => "DB_IO".AQ.AQ1_CurrentCtrl_V,
	         AQ_OutputOff_V => "DB_IO".AQ.AQ3_OutputOff,
	         State => "DB_Status".LabPSU.State,
	         StatusText => "DB_Status".LabPSU.StatusText);

	// Logovani - vzorkovani v OB30 (100ms), SampleEveryN=2 -> 200ms vzorek
	// File I/O (FlushPending) se zpracovava v Main (OB1), ne zde
	"LogManager"(
		Enable := "DB_LogConfig".Enable,
		StartTest := "DB_LogConfig".StartTest,
		StopTest := "DB_LogConfig".StopTest,
		RPM := "DB_HMI".Sensors.TM_Rotation_A_Channel,
		T_Lozisko := "DB_HMI".Sensors.AI1_Teplota_Lozisko_C,
		T_Uhliky := 0.0,      // TODO: napojit na skutecny senzor teploty uhliku
		Vibrace := 0.0,       // TODO: napojit na skutecny senzor vibraci
		ProudUhliky := ("DB_IO".AQ.AQ1_CurrentCtrl_V / 5.0) * 60.0,
		State := "DB_Status".Spindel.State,
		RunLatched := "DB_Status".Spindel.RunLatched,
		TripActive := "DB_Status".Safety.TripActive,
		TripCode := "DB_Status".Safety.TripCode,
		SafetyText := "DB_Status".Safety.StatusText,
		SampleEveryN_Cycles := 2,
		TestDuration_s := "DB_LogConfig".TestDuration_s,
		FlushEveryN := "DB_LogConfig".FlushEveryN,
		AckFlush := "LogFlushToSd".AckFlush
	);
END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Sweep (Cycle)"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP
      WwwRetVal : Int;
   END_VAR


BEGIN
	//******************************************************************
	// IO MAP READ
	//******************************************************************
	"FC_IO_Map_Read"();
	"TM_Counter"(SwGate:=TRUE,
	             CaptureEnable:=FALSE,
	             SyncEnable:=FALSE,
	             ErrorAck:=FALSE,
	             EventAck:=FALSE,
	             MeasuredValue => "DB_IO".TM.MeasuredValue);

	"FC_ConvertIO"();


	//******************************************************************
	// CALL FB BLOCKS - PRODUCTION LOGIC
	//******************************************************************
	"DB_Alarms".TempHigh := "DB_HMI".Sensors.AI1_Teplota_Lozisko_C > "DB_Config".TempHighThreshold_C;

	// Nektere safety signaly nemame implementovane - teplota, vibrace. Zatim bude potreba je simulovat
	"Safety_1"(Enable:= TRUE, // This signal can be used to bind to another system in the future
	           EmergencyStop:="DB_IO".DI.EmergencyStop,
	           SafetyRelayAuxOk:= "DB_IO".DI.SafetyRelayAuxOk,
	           ExternalFault:= "DB_IO".DI.ExternalFault,
	           TempAlarm:="DB_Alarms".TempHigh,
	           VibAlarm:= "DB_Alarms".VibCritical,
	           SafetyOk => "DB_Status".Safety.SafetyOk,
	           PermitMotion => "DB_Status".Safety.PermitMotion,
	           TripActive => "DB_Status".Safety.TripActive, // TripActive znamena "bezpecne odpojeni vykonovych vystupu systemu"
	           TripCode => "DB_Status".Safety.TripCode,
	           StatusText => "DB_Status".Safety.StatusText
	);


	"Spindel"(HMI_Start:= "DB_HMI".Spindle.Start,
	          HMI_Stop:="DB_HMI".Spindle.Stop,
	          HMI_ResetFault:="DB_HMI".Spindle.ResetFault,
	          HMI_Speed_RPM:="DB_HMI".Spindle.Speed_RPM,
	          PermitMotion:="DB_Status".Safety.PermitMotion,
	          EmergencyStop:="DB_IO".DI.EmergencyStop,
	          ExternalFaultIn:="DB_IO".DI.ExternalFault,
	          SpeedMax_RPM:=18000.0,
	          AO_MaxVolt:=10.0,
	          RampUp_RPM_per_s:=6000.0,
	          RampDown_RPM_per_s:=9000.0,
	          ResetPulse:=T#300MS,
	          RequireSpeedToRun:=FALSE,
	          DO_RunForward=>"DB_IO".DQ.RunForwardCmd,
	          DO_FaultReset=>"DB_IO".DQ.FaultResetCmd,
	          DO_MultiSpeed1=>"DB_IO".DQ.MultiSpeed1,
	          DO_ExternalFault=>"DB_IO".DQ.ExternalFault,
	          AQ1_Voltage_0_10V=>"DB_IO".AQ.SpeedVoltage,
	          RunLatched=>"DB_Status".Spindel.RunLatched,
	          TripActive=>"DB_Status".Spindel.TripActive,
	          State=>"DB_Status".Spindel.State,
	          StatusText=>"DB_Status".Spindel.StatusText);


	//******************************************************************
	// CALL OTHER FB BLOCKS
	//******************************************************************
	"FB_SafetyButtons_DB"(DI0_AuxSafetyRelay:="DB_IO".DI.SafetyRelayAuxOk,
	                      DI1_SafetyButton:="DB_IO".DI.EmergencyStop,
	                      DQ0_LED=>"DB_IO".DQ.ResetButtonLed,
	                      DQ1_LED=>"DB_IO".DQ.EmergencyStopButtonLed);

	// ----------------------------------------------------------------
	// FAZE 2: Davkovy zapis logu na SD kartu
	// FlushPending nebo FinalFlush spusti stavovy automat LogFlushToSd.
	// Po dokonceni AckFlush resetuje FlushPending ve FB_LogManager.
	// ----------------------------------------------------------------
	"LogFlushToSd"(
		Enable          := "DB_LogConfig".Enable,
		FlushRequest    := "LogManager".FlushPending,
		FinalFlush      := NOT "DB_LogRuntime".TestActive AND "LogManager".FlushPending,
		MaxRowsPerFlush := 50,
		RetryLimit      := 3
	);
END_ORGANIZATION_BLOCK

