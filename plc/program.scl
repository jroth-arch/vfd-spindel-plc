FUNCTION_BLOCK "FB_LogFlushToSd"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT
		Enable : Bool;                    // povoleni flushe (z DB_LogConfig.Enable)
		FlushRequest : Bool;              // pozadavek na flush (z LogManager.FlushPending)
		FinalFlush : Bool;                // TRUE = zapsat vse bez limitu (pri manual stopu)
		MaxRowsPerFlush : Int := 50;      // max radku na jeden flush (50 = ~5s pri 10 FileWriteC/s)
		RetryLimit : Int := 3;            // max pokusu po chybe pred nastavenim Error=TRUE
	END_VAR

	VAR_OUTPUT
		Busy : Bool;               // TRUE = flush probiha (stavovy automat mimo IDLE)
		AckFlush : Bool;           // potvrzeni flushe pro LogManager (drzi TRUE dokud FlushRequest neklesne)
		Error : Bool;              // TRUE = flush selhal po vsech retry pokusech
		ErrorCode : Word;          // posledni FileWriteC status kod (napr. 0x7001=soubor neexistuje)
		CurrentStep : USInt;       // aktualni krok automatu: 0=IDLE 1=PREP 2=OPEN 3=HDR 4=ROW 5=NEXT 6=CLOSE 7=ACK 10=ERR 11=MKDIR
		RowsFlushed : Int;         // pocet radku zapsanych pri poslednim flushu
	END_VAR

	VAR
		Step : USInt;
		RowIdx : Int;
		RowsToFlush : Int;
		RowsDone : Int;
		RetryCount : Int;
		prevFlushReq : Bool;
		writeReq : Bool;
		writeStarted : Bool;
		filePath : String[64];
		CsvLine : String[254];
		CsvBytes : Array[0..253] of Byte;
		writeOffset : UDInt;
		fileOffset_Bytes : UDInt;
		writeLength : UDInt;
		writeResultLength : UDInt;
		fwDone : Bool;
		fwBusy : Bool;
		fwError : Bool;
		dirCreated : Bool := FALSE;  // Flag pro sledovani, zda byla slozka vytvorena
		dirCreateStarted : Bool;

		FileWriteC_1 {InstructionName := 'FileWriteC'; LibVersion := '1.0'} : FileWriteC;
		FileWriteC_DirKeeper {InstructionName := 'FileWriteC'; LibVersion := '1.0'} : FileWriteC;  // Pro vytvoreni slozky
		FileStatus : Word;
	END_VAR

	VAR_TEMP
		rowsAvail : Int;
		csvLen : Int;
		i : Int;
	END_VAR

	VAR CONSTANT
		STEP_IDLE : USInt := 0;
		STEP_PREPARE : USInt := 1;
		STEP_CREATE_DIR : USInt := 11;  // Novy stav pro vytvoreni slozky
		STEP_OPEN : USInt := 2;
		STEP_WR_HEADER : USInt := 3;
		STEP_WR_ROW : USInt := 4;
		STEP_NEXT_ROW : USInt := 5;
		STEP_CLOSE : USInt := 6;
		STEP_ACK : USInt := 7;
		STEP_ERROR : USInt := 10;
	END_VAR

BEGIN
	// AckFlush is NOT reset here – STEP_IDLE holds it until FlushRequest drops (4-way handshake)
	CurrentStep := Step;  // Diagnostika - exportovat aktualni krok

	CASE Step OF
		STEP_IDLE:
			Busy := FALSE;
			Error := FALSE;
			writeReq := FALSE;
			writeStarted := FALSE;
			// Hold AckFlush TRUE until FlushRequest drops so OB30 (1000ms) can see it
			IF NOT FlushRequest THEN
				AckFlush := FALSE;
			END_IF;
			IF Enable AND (FlushRequest AND NOT prevFlushReq) THEN
				Busy := TRUE;
				Step := STEP_PREPARE;
			END_IF;

		STEP_PREPARE:
			IF "DB_LogBuffer".TrendWriteIdx >= "DB_LogBuffer".TrendReadIdx THEN
				rowsAvail := "DB_LogBuffer".TrendWriteIdx - "DB_LogBuffer".TrendReadIdx;
			ELSE
				rowsAvail := (1000 - "DB_LogBuffer".TrendReadIdx) + "DB_LogBuffer".TrendWriteIdx;
			END_IF;

			IF FinalFlush THEN
				RowsToFlush := rowsAvail;
			ELSE
				RowsToFlush := rowsAvail;
				IF RowsToFlush > MaxRowsPerFlush THEN
					RowsToFlush := MaxRowsPerFlush;
				END_IF;
			END_IF;

			IF RowsToFlush <= 0 THEN
				Step := STEP_ACK;
			ELSE
				RowIdx := "DB_LogBuffer".TrendReadIdx;
				RowsDone := 0;
				RetryCount := 0;
				filePath := CONCAT(IN1 := 'UserFiles/', IN2 := "DB_LogRuntime".FileName);
				// Pokud slozka jeste nebyla vytvorena, zkus ji vytvorit nejdriv
				IF NOT dirCreated THEN
					Step := STEP_CREATE_DIR;
				ELSE
					Step := STEP_OPEN;
				END_IF;
			END_IF;

		STEP_CREATE_DIR:
			// Vytvoreni slozky UserFiles pomoci zapisu prazdneho keep souboru
			IF NOT dirCreateStarted THEN
				CsvBytes[0] := 0;  // Prazdny obsah
				writeReq := TRUE;
				dirCreateStarted := TRUE;
			END_IF;

			FileWriteC_DirKeeper(
				REQ := writeReq,
				Name := 'UserFiles/.keepdir',  // Pomocny soubor pro vytvoreni slozky
				Offset := 0,
				Length := 1,
				Done => fwDone,
				Busy => fwBusy,
				Error => fwError,
				Status => FileStatus,
				ResultLength => writeResultLength,
				Data := CsvBytes
			);

			writeReq := FALSE;

			IF fwDone THEN
				// Slozka uspesne vytvorena (nebo uz existovala)
				dirCreated := TRUE;
				dirCreateStarted := FALSE;
				writeStarted := FALSE;
				Step := STEP_OPEN;
			ELSIF fwError THEN
				// Chyba pri vytvareni - pokracuj dale, mozna slozka uz existuje
				// Nebo to zkus bez slozky
				IF FileStatus = 16#7002 OR FileStatus = 16#0000 OR FileStatus = 16#7000 THEN
					// 0x7002 = uz existuje, 0x7000 = generic warning - to je OK
					dirCreated := TRUE;
				END_IF;
				dirCreateStarted := FALSE;
				writeStarted := FALSE;
				Step := STEP_OPEN;
			ELSIF NOT fwBusy AND dirCreateStarted THEN
				// FileWriteC skoncil (Busy=FALSE) ale nenastavil Done ani Error
				// Tento stav muze nastat pri 16#7000 (warning misto error)
				// Pokracuj dale, pravdepodobne slozka existuje
				dirCreated := TRUE;
				dirCreateStarted := FALSE;
				writeStarted := FALSE;
				Step := STEP_OPEN;
			END_IF;

		STEP_OPEN:
			IF LEN(filePath) = 0 THEN
				FileStatus := 16#8001;
				Step := STEP_ERROR;
			ELSE
				IF NOT "DB_LogRuntime".HeaderWritten THEN
					fileOffset_Bytes := 0;
				END_IF;
				IF "DB_LogRuntime".HeaderWritten THEN
					Step := STEP_WR_ROW;
				ELSE
					Step := STEP_WR_HEADER;
				END_IF;
			END_IF;

		STEP_WR_HEADER:
			IF NOT writeStarted THEN
				CsvLine := 't_s,RPM,T_Lozisko,T_Uhliky,Vibrace,ProudUhliky,State,RunLatched,TripActive,TripCode,SafetyText,TestActive,StopReason';
				csvLen := LEN(CsvLine);
				FOR i := 0 TO 253 DO
					CsvBytes[i] := 0;
				END_FOR;
				FOR i := 1 TO csvLen DO
					CsvBytes[i - 1] := CHAR_TO_BYTE(CsvLine[i]);
				END_FOR;
				// Add CRLF (0x0D, 0x0A) for line ending
				CsvBytes[csvLen] := 13;
				CsvBytes[csvLen + 1] := 10;
				writeOffset := fileOffset_Bytes;
				writeLength := INT_TO_UDINT(csvLen + 2);
				writeReq := TRUE;
				writeStarted := TRUE;
			END_IF;

			FileWriteC_1(
				REQ := writeReq,
				Name := filePath,
				Offset := writeOffset,
				Length := writeLength,
				Done => fwDone,
				Busy => fwBusy,
				Error => fwError,
				Status => FileStatus,
				ResultLength => writeResultLength,
				Data := CsvBytes
			);

			writeReq := FALSE;

			IF fwDone THEN
				fileOffset_Bytes := fileOffset_Bytes + writeResultLength;
				"DB_LogRuntime".HeaderWritten := TRUE;
				writeStarted := FALSE;
				Step := STEP_WR_ROW;
			ELSE
				IF fwError THEN
					writeStarted := FALSE;
					Step := STEP_ERROR;
				END_IF;
			END_IF;

		STEP_WR_ROW:
			IF NOT writeStarted THEN
				CsvLine := "FC_LogRecordToCsv"(Rec := "DB_LogBuffer".TrendBuffer[RowIdx]);
				csvLen := LEN(CsvLine);
				FOR i := 0 TO 253 DO
					CsvBytes[i] := 0;
				END_FOR;
				FOR i := 1 TO csvLen DO
					CsvBytes[i - 1] := CHAR_TO_BYTE(CsvLine[i]);
				END_FOR;
				// Add CRLF (0x0D, 0x0A) for line ending
				CsvBytes[csvLen] := 13;
				CsvBytes[csvLen + 1] := 10;
				writeOffset := fileOffset_Bytes;
				writeLength := INT_TO_UDINT(csvLen + 2);
				writeReq := TRUE;
				writeStarted := TRUE;
			END_IF;

			FileWriteC_1(
				REQ := writeReq,
				Name := filePath,
				Offset := writeOffset,
				Length := writeLength,
				Done => fwDone,
				Busy => fwBusy,
				Error => fwError,
				Status => FileStatus,
				ResultLength => writeResultLength,
				Data := CsvBytes
			);

			writeReq := FALSE;

			IF fwDone THEN
				fileOffset_Bytes := fileOffset_Bytes + writeResultLength;
				writeStarted := FALSE;
				Step := STEP_NEXT_ROW;
			ELSE
				IF fwError THEN
					writeStarted := FALSE;
					Step := STEP_ERROR;
				END_IF;
			END_IF;

		STEP_NEXT_ROW:
			RowsDone := RowsDone + 1;
			RowIdx := RowIdx + 1;
			IF RowIdx >= 1000 THEN
				RowIdx := 0;
			END_IF;

			IF RowsDone >= RowsToFlush THEN
				Step := STEP_CLOSE;
			ELSE
				Step := STEP_WR_ROW;
			END_IF;

		STEP_CLOSE:
			Step := STEP_ACK;

		STEP_ACK:
			"DB_LogBuffer".TrendReadIdx := "DB_LogBuffer".TrendReadIdx + RowsDone;
			IF "DB_LogBuffer".TrendReadIdx >= 1000 THEN
				"DB_LogBuffer".TrendReadIdx := "DB_LogBuffer".TrendReadIdx - 1000;
			END_IF;
			"DB_LogRuntime".LastFlushOk := TRUE;
			RowsFlushed := RowsDone;  // Diagnostika
			AckFlush := TRUE;
			Busy := FALSE;
			Error := FALSE;
			Step := STEP_IDLE;

		STEP_ERROR:
			"DB_LogRuntime".LastFlushOk := FALSE;
			"DB_LogRuntime".FlushErrorCount := "DB_LogRuntime".FlushErrorCount + 1;
			"DB_LogRuntime".LastError := CONCAT(IN1 := 'FILEWRITEC STATUS ', IN2 := UINT_TO_STRING(WORD_TO_UINT(FileStatus)));
			ErrorCode := FileStatus;
			
			// Pokud je chyba 0x7001 (soubor/slozka neexistuje) a jeste jsme nezkusili vytvorit slozku
			IF (FileStatus = 16#7001) AND NOT dirCreated THEN
				// Zkus vytvorit slozku a pak retry
				writeStarted := FALSE;
				Step := STEP_CREATE_DIR;
			ELSE
				// Standardni retry logika
				RetryCount := RetryCount + 1;
				IF RetryCount <= RetryLimit THEN
					Step := STEP_OPEN;
				ELSE
					Error := TRUE;
					Busy := FALSE;
					AckFlush := TRUE;
					Step := STEP_IDLE;
				END_IF;
			END_IF;
	END_CASE;

	prevFlushReq := FlushRequest;
END_FUNCTION_BLOCK

DATA_BLOCK "LogFlushToSd"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_LogFlushToSd"

BEGIN

END_DATA_BLOCK

ORGANIZATION_BLOCK OB30
TITLE = "Cyclic Interrupt - 1000ms"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_TEMP
		currentTs : DTL;
		secNow_ms : DInt;
		secLast_ms : DInt;
		deltaMs : DInt;
		retVal : Int;
	END_VAR

BEGIN
	// Measure OB30 cycle time using RD_SYS_T()
	retVal := RD_SYS_T(currentTs);
	IF retVal = 0 AND "DB_LogRuntime".OB30_LastTs.NANOSECOND > 0 THEN
		// Cast USInt SECOND to DInt before multiply, then subtract to avoid type range error
		secNow_ms  := USINT_TO_DINT(currentTs.SECOND) * 1000 + UDINT_TO_DINT(currentTs.NANOSECOND / 1000000);
		secLast_ms := USINT_TO_DINT("DB_LogRuntime".OB30_LastTs.SECOND) * 1000 + UDINT_TO_DINT("DB_LogRuntime".OB30_LastTs.NANOSECOND / 1000000);
		deltaMs := secNow_ms - secLast_ms;
		IF deltaMs < 0 THEN deltaMs := deltaMs + 60000; END_IF;  // minute rollover (59→0)
		IF deltaMs > 32767 THEN deltaMs := 32767; END_IF;
		"DB_LogRuntime".OB30_CycleTime_ms := DINT_TO_INT(deltaMs);
		IF "DB_LogRuntime".OB30_CycleTime_ms > "DB_LogRuntime".OB30_MaxCycleTime_ms THEN
			"DB_LogRuntime".OB30_MaxCycleTime_ms := "DB_LogRuntime".OB30_CycleTime_ms;
		END_IF;
		IF "DB_LogRuntime".OB30_CycleTime_ms < "DB_LogRuntime".OB30_MinCycleTime_ms THEN
			"DB_LogRuntime".OB30_MinCycleTime_ms := "DB_LogRuntime".OB30_CycleTime_ms;
		END_IF;
	END_IF;
	IF retVal = 0 THEN
		"DB_LogRuntime".OB30_LastTs := currentTs;
	END_IF;
	
	// OB30 cycle counter (diagnostic - should increment by ~1 per second)
	IF "DB_LogRuntime".TestActive THEN
		"DB_LogRuntime".OB30_CycleCounter := "DB_LogRuntime".OB30_CycleCounter + 1;
	END_IF;

	// LabPSU - Current control (1s cycle time)
	"LabPSU"(Enable := "DB_HMI".LabPSU.Enable AND "DB_LogRuntime".TestActive,
	         PermitOutput := "DB_Status".Safety.PermitMotion,
	         Mode := "DB_HMI".LabPSU.Mode,
	         Cycle_s := 1.0,  // 1s cycle time (OB30 = 1000ms)
	         BaseVoltage_V := "DB_HMI".LabPSU.BaseVoltage_V,
	         CurrentOffset_A := "DB_HMI".LabPSU.CurrentOffset_A,
	         DebugAmplitude_A := "DB_HMI".LabPSU.DebugAmplitude_A,
	         DebugPeriod_min := "DB_HMI".LabPSU.DebugPeriod_min,
	         ConstCurrent_A := "DB_HMI".LabPSU.ConstCurrent_A,
	         RampUp_A_per_s := 50.0,
	         RampDown_A_per_s := 80.0,
	         PSU_MinVoltage_V := 0.8,
	         PSU_MaxVoltage_V := 16.0,
	         PSU_MaxCurrent_A := "DB_HMI".LabPSU.MaxCurrent_A,
	         RemoteMaxCtrl_V := 5.0,
	         VoltageSet_V => "DB_Status".LabPSU.VoltageSet_V,
	         CurrentSet_A => "DB_Status".LabPSU.CurrentSet_A,
	         AQ2_VoltageCtrl_V => "DB_IO".AQ.AQ2_VoltageCtrl_V,
	         AQ3_CurrentCtrl_V => "DB_IO".AQ.AQ1_CurrentCtrl_V,
	         AQ_OutputOff_V => "DB_IO".AQ.AQ3_OutputOff,
	         State => "DB_Status".LabPSU.State,
	         StatusText => "DB_Status".LabPSU.StatusText,
	         CurrentLimitExceeded => "DB_HMI".LabPSU.CurrentLimitExceeded,
	         SineCycleCounter => "DB_HMI".LabPSU.SineCycleCounter);

	// Logovani - vzorkovani kazdou 1s, SampleEveryN=6 -> 6s vzorek
	// File I/O (FlushPending) se zpracovava v Main (OB1), ne zde
	"LogManager"(
		Enable := "DB_LogConfig".Enable,
		StartTest := "DB_LogConfig".StartTest OR "DB_LogRuntime".StartReqLatched,
		StopTest := "DB_LogConfig".StopTest OR "DB_LogRuntime".StopReqLatched,
		RPM := "DB_HMI".Sensors.TM_Rotation_A_Channel,
		T_Lozisko := "DB_HMI".Sensors.AI1_Teplota_Lozisko_C,
		T_Uhliky := 0.0,      // TODO: napojit na skutecny senzor teploty uhliku
		Vibrace := 0.0,       // TODO: napojit na skutecny senzor vibraci
		ProudUhliky := ("DB_IO".AQ.AQ1_CurrentCtrl_V / 5.0) * 60.0,
		State := "DB_Status".Spindel.State,
		RunLatched := "DB_Status".Spindel.RunLatched,
		TripActive := "DB_Status".Safety.TripActive,
		TripCode := "DB_Status".Safety.TripCode,
		SafetyText := "DB_Status".Safety.StatusText,
		SampleEveryN_Cycles := 6,
		TestDuration_s := "DB_LogConfig".TestDuration_s,
		FlushEveryN := "DB_LogConfig".FlushEveryN,
		AckFlush := "LogFlushToSd".AckFlush
	);
	
	//******************************************************************
	// AUTO-RESET pulse bits (provádí se každou 1s, AŽ PO LogManager)
	// Aby LogManager stihl detekovat hranu před resetem!
	//******************************************************************
	IF "LogManager".EdgeStartDetected THEN
		"DB_LogConfig".StartTest := FALSE;
		"DB_LogRuntime".StartReqLatched := FALSE;
	END_IF;
	IF "LogManager".EdgeStopDetected THEN
		"DB_LogConfig".StopTest := FALSE;
		"DB_LogRuntime".StopReqLatched := FALSE;
	END_IF;
END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK OB1
TITLE = "Main Program Sweep (Cycle)"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP
      WwwRetVal : Int;
   END_VAR


BEGIN
	//******************************************************************
	// IO MAP READ
	//******************************************************************
	"FC_IO_Map_Read"();
	"TM_Counter"(SwGate:=TRUE,
	             CaptureEnable:=FALSE,
	             SyncEnable:=FALSE,
	             ErrorAck:=FALSE,
	             EventAck:=FALSE,
	             MeasuredValue => "DB_IO".TM.MeasuredValue);

	// POZOR: FC_ConvertIO se volá AŽ na konci OB1, po všech FB!

	//******************************************************************
	// CALL FB BLOCKS - PRODUCTION LOGIC
	//******************************************************************
	"DB_Alarms".TempHighLozisko := "DB_HMI".Sensors.AI1_Teplota_Lozisko_C > "DB_Config".TempHighThreshold_C;
	"DB_Alarms".TempHighKartace := "DB_HMI".Sensors.AI2_Teplota_Kartace_C > "DB_Config".TempHighThreshold_C;
	"DB_Alarms".TempAlarm := "DB_Alarms".TempHighLozisko OR "DB_Alarms".TempHighKartace;

	// Nektere safety signaly nemame implementovane - teplota, vibrace. Zatim bude potreba je simulovat
	"Safety_1"(Enable:= TRUE, // This signal can be used to bind to another system in the future
	           EmergencyStop:="DB_IO".DI.EmergencyStop,
	           SafetyRelayAuxOk:= "DB_IO".DI.SafetyRelayAuxOk,
	           ExternalFault:= "DB_IO".DI.ExternalFault,
	           TempAlarm:="DB_Alarms".TempAlarm,
	           VibAlarm:= "DB_Alarms".VibCritical,
	           SafetyOk => "DB_Status".Safety.SafetyOk,
	           PermitMotion => "DB_Status".Safety.PermitMotion,
	           TripActive => "DB_Status".Safety.TripActive, // TripActive znamena "bezpecne odpojeni vykonovych vystupu systemu"
	           TripCode => "DB_Status".Safety.TripCode,
	           StatusText => "DB_Status".Safety.StatusText
	);


	"Spindel"(HMI_Start:= "DB_HMI".Spindle.Start,
	          HMI_Stop:="DB_HMI".Spindle.Stop,
	          HMI_ResetFault:="DB_HMI".Spindle.ResetFault,
	          HMI_Speed_RPM:="DB_HMI".Spindle.Speed_RPM,
	          PermitMotion:="DB_Status".Safety.PermitMotion,
	          EmergencyStop:="DB_IO".DI.EmergencyStop,
	          ExternalFaultIn:="DB_IO".DI.ExternalFault,
	          SpeedMax_RPM:=18000.0,
	          AO_MaxVolt:=10.0,
	          RampUp_RPM_per_s:=6000.0,
	          RampDown_RPM_per_s:=9000.0,
	          ResetPulse:=T#300MS,
	          RequireSpeedToRun:=FALSE,
	          DO_RunForward=>"DB_IO".DQ.RunForwardCmd,
	          DO_FaultReset=>"DB_IO".DQ.FaultResetCmd,
	          DO_MultiSpeed1=>"DB_IO".DQ.MultiSpeed1,
	          DO_ExternalFault=>"DB_IO".DQ.ExternalFault,
	          AQ1_Voltage_0_10V=>"DB_IO".AQ.SpeedVoltage,
	          RunLatched=>"DB_Status".Spindel.RunLatched,
	          TripActive=>"DB_Status".Spindel.TripActive,
	          State=>"DB_Status".Spindel.State,
	          StatusText=>"DB_Status".Spindel.StatusText);

	//******************************************************************
	// AUTO-RESET Spindle pulse bits (v OB1, hned po volání Spindel FB)
	//******************************************************************
	IF "DB_HMI".Spindle.Start THEN
		"DB_HMI".Spindle.Start := FALSE;
	END_IF;
	IF "DB_HMI".Spindle.Stop THEN
		"DB_HMI".Spindle.Stop := FALSE;
	END_IF;

	//******************************************************************
	// LATCH Start/Stop requestu z HMI do runtime DB (OB1 je rychly)
	// Chrani hrany StartTest/StopTest pred ztratou pri OB30=1000ms.
	//******************************************************************
	IF "DB_LogConfig".StartTest THEN
		"DB_LogRuntime".StartReqLatched := TRUE;
	END_IF;
	IF "DB_LogConfig".StopTest THEN
		"DB_LogRuntime".StopReqLatched := TRUE;
		"DB_LogRuntime".StopSequenceActive := TRUE;
	END_IF;

	//******************************************************************
	// CALL OTHER FB BLOCKS
	//******************************************************************
	"FB_SafetyButtons_DB"(DI0_AuxSafetyRelay:="DB_IO".DI.SafetyRelayAuxOk,
	                      DI1_SafetyButton:="DB_IO".DI.EmergencyStop,
	                      DQ0_LED=>"DB_IO".DQ.ResetButtonLed,
	                      DQ1_LED=>"DB_IO".DQ.EmergencyStopButtonLed);

	// ----------------------------------------------------------------
	// FAZE 2: Davkovy zapis logu na SD kartu
	// FlushPending nebo FinalFlush spusti stavovy automat LogFlushToSd.
	// ----------------------------------------------------------------
	// FAZE 2: Davkovy zapis logu na SD kartu
	// FlushPending nebo FinalFlush spusti stavovy automat LogFlushToSd.
	// Po dokonceni AckFlush resetuje FlushPending ve FB_LogManager.
	// ----------------------------------------------------------------
	"LogFlushToSd"(
		Enable          := "DB_LogConfig".Enable,
		FlushRequest    := "LogManager".FlushPending,
		FinalFlush      := NOT "DB_LogRuntime".TestActive AND "LogManager".FlushPending,
		MaxRowsPerFlush := 50,
		RetryLimit      := 3
	);

	//******************************************************************
	// AUTO START LabPSU - deterministicky pri nabehu TestActive (ne jen edge)
	//******************************************************************
	IF "DB_LogRuntime".TestActive AND NOT "DB_LogRuntime".TestActivePrev THEN
		"DB_HMI".LabPSU.Enable := TRUE;
		"DB_HMI".LabPSU.Mode := 2;  // SINE_DEBUG
		"DB_LogRuntime".LastStopLogSaved := FALSE;
	END_IF;

	//******************************************************************
	// STOP COMPLETE - po final flush nastav defaulty pro dalsi test
	//******************************************************************
	IF "DB_LogRuntime".StopSequenceActive
		AND NOT "DB_LogRuntime".TestActive
		AND NOT "LogManager".FlushPending
		AND NOT "LogFlushToSd".AckFlush THEN
		"DB_HMI".LabPSU.Enable := FALSE;
		"DB_HMI".LabPSU.Mode := 2;  // dalsi AUTO startuje v SINE rezimu
		"DB_HMI".Spindle.Speed_RPM := 0.0;
		"DB_LogConfig".Enable := FALSE;
		"DB_LogRuntime".LastStopLogSaved := "DB_LogRuntime".LastFlushOk;
		"DB_LogRuntime".StopSequenceActive := FALSE;
	END_IF;
	
	//******************************************************************
	// AUTO STOP - Test timeout handling - VYPNUTO (test bezi do nekonecna)
	// Kdyz test dosahl casu TestDuration_s, automaticky zastav vse
	//******************************************************************
	// IF "LogManager".TestTimeoutReached THEN
	// 	// Automaticky zastav vreteno - puls se vygeneruje pres HMI bit
	// 	// (FB_DriveCtrl ma edge detection, takze staci nastavit a zresetovat v dalsim cyklu)
	// 	IF NOT "DB_HMI".Spindle.Stop THEN
	// 		"DB_HMI".Spindle.Stop := TRUE;
	// 	ELSE
	// 		"DB_HMI".Spindle.Stop := FALSE;
	// 		"LogManager".TestTimeoutReached := FALSE;  // Reset timeout flag
	// 	END_IF;
	// 	
	// 	// Vypni laboratorni zdroj
	// 	"DB_HMI".LabPSU.Enable := FALSE;
	// 	
	// 	// Stop log (puls) - FlushPending uz je TRUE z FB_LogManager
	// 	// TestActive uz je FALSE z FB_LogManager
	// END_IF;
	
	//******************************************************************
	// HMI HELPER - Status panel color (Basic Panel limitation)
	// Priority: RED (trip) > GREEN (running) > GRAY (ready)
	//******************************************************************
	//******************************************************************
	IF "DB_Status".Safety.TripActive THEN
		"DB_Status".HMI_StatusColor := 2;  // RED - error/trip active
		"DB_Status".HMI_StatusText := 'ERROR - TRIP ACTIVE';
	ELSE
		IF "DB_LogRuntime".TestActive THEN
			IF "DB_HMI".Spindle.Speed_RPM <= 0.0 THEN
				"DB_Status".HMI_StatusColor := 3;  // AMBER - running but setpoint is zero
				"DB_Status".HMI_StatusText := 'RUNNING - RPM=0';
			ELSE
				"DB_Status".HMI_StatusColor := 1;  // GREEN - test running
				"DB_Status".HMI_StatusText := 'TEST RUNNING';
			END_IF;
		ELSE
			"DB_Status".HMI_StatusColor := 0;  // GRAY - ready/stopped
			IF "DB_LogRuntime".LastStopLogSaved THEN
				"DB_Status".HMI_StatusText := 'READY - LOG SAVED';
			ELSE
				"DB_Status".HMI_StatusText := 'TEST READY';
			END_IF;
		END_IF;
	END_IF;

	"DB_LogRuntime".TestActivePrev := "DB_LogRuntime".TestActive;
	
	//******************************************************************
	// CONVERT IO - AŽ na konci, po všech FB!
	//******************************************************************
	"FC_ConvertIO"();
	
	//******************************************************************
	// IO MAP WRITE - zapisat vypocitane vystupy na fyzicke vystupy
	//******************************************************************
	"FC_IO_Map_Write"();
END_ORGANIZATION_BLOCK

