		TrendBuffer : ARRAY[0..999] OF "UDT_LogRecord";
		EventBuffer : ARRAY[0..99] OF "UDT_EventRecord";
		TrendWriteIdx : Int;
		TrendReadIdx : Int;
		EventWriteIdx : Int;
		EventReadIdx : Int;
	END_VAR
BEGIN
	TrendWriteIdx := 0;
	TrendReadIdx := 0;
	EventWriteIdx := 0;
	EventReadIdx := 0;
END_DATA_BLOCK

DATA_BLOCK "DB_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
