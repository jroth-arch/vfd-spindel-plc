DATA_BLOCK "DB_Config"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		TempHighThreshold_C : Real;
		VibCriticalThreshold : Real;
		DAC_MaxDacRange : Int;
		InputSim : Struct
			EnableSafetyRelayAuxOverride : Bool;
			SafetyRelayAuxOk : Bool;
			EnableEmergencyStopOverride : Bool;
			EmergencyStop : Bool;
		END_STRUCT;
	END_VAR

BEGIN
	TempHighThreshold_C := 35.0;
	VibCriticalThreshold := 0.0;
	DAC_MaxDacRange := 27648;
	InputSim.EnableSafetyRelayAuxOverride := false;
