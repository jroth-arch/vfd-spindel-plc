// --- HELPER FUNCTION: Convert seconds (Real) to HHH:MM:SS string ---
FUNCTION "FC_SecondsToTimeString" : String[9]
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT 
		seconds : Real;
	END_VAR
	VAR_TEMP 
		totalSec : DInt;
		hours : Int;
		minutes : Int;
		secs : Int;
		h1, h2, h3, m1, m2, s1, s2 : USInt;
	END_VAR
BEGIN
	// Convert to integer seconds
	totalSec := REAL_TO_DINT(seconds);
	
	// Calculate hours, minutes, seconds
	hours := DINT_TO_INT(totalSec / 3600);
	minutes := DINT_TO_INT((totalSec MOD 3600) / 60);
	secs := DINT_TO_INT(totalSec MOD 60);
	
	// Limit to 999:59:59 max display (over 41 days)
	IF hours > 999 THEN
		hours := 999;
		minutes := 59;
		secs := 59;
	END_IF;
	
	// Convert to ASCII digit values (digit type USInt, like in existing code)
	h1 := UINT_TO_USINT(hours / 100);
	h2 := UINT_TO_USINT((hours MOD 100) / 10);
	h3 := UINT_TO_USINT(hours MOD 10);
	m1 := UINT_TO_USINT(minutes / 10);
	m2 := UINT_TO_USINT(minutes MOD 10);
	s1 := UINT_TO_USINT(secs / 10);
	s2 := UINT_TO_USINT(secs MOD 10);
	
	// Build string "HHH:MM:SS" using BYTE_TO_CHAR like existing filename code
	#FC_SecondsToTimeString := CONCAT(IN1 := BYTE_TO_CHAR(48 + h1), IN2 := BYTE_TO_CHAR(48 + h2));
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := BYTE_TO_CHAR(48 + h3));
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := ':');
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := BYTE_TO_CHAR(48 + m1));
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := BYTE_TO_CHAR(48 + m2));
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := ':');
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := BYTE_TO_CHAR(48 + s1));
	#FC_SecondsToTimeString := CONCAT(IN1 := #FC_SecondsToTimeString, IN2 := BYTE_TO_CHAR(48 + s2));
END_FUNCTION

// --- LOGGING FUNCTION BLOCK ---
// Volani:
//   OB30 (1000ms): LogManager.SampleStep()   - plni buffer kazdych SampleEveryN_Cycles cyklu
//   Main (OB1):   LogManager.FlushPending   - zkontroluj flag a zapis na SD
FUNCTION_BLOCK "FB_LogManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT
		Enable : Bool;                     // povoleni logovani (z DB_LogConfig.Enable)
		StartTest : Bool;                  // hrana = start testu (z DB_LogConfig.StartTest)
		StopTest : Bool;                   // hrana = manual stop testu (z DB_LogConfig.StopTest)
		RPM : Real;                        // aktualni otacky vretene [RPM]
		T_Lozisko : Real;                  // teplota loziska [degC]
		T_Uhliky : Real;                   // teplota uhliku/kartacu [degC] – zatim 0.0
		Vibrace : Real;                    // vibrace – zatim 0.0
		ProudUhliky : Real;                // proud do uhliku [A], prepocitany z AQ1_CurrentCtrl_V
		State : USInt;                     // stav vretene: 0=STOP 1=RUN 2=STOPPING 3=TRIP
		RunLatched : Bool;                 // vreteno v provozu (latch z FB_DriveCtrl)
		TripActive : Bool;                 // safety trip aktivni
		TripCode : USInt;                  // kod tripu: 0=OK 1=ESTOP 2=RELAY 3=EXT 4=TEMP 5=VIB 6=DISABLE
		SafetyText : String[40];           // textova diagnostika safety brany
		SampleEveryN_Cycles : Int := 6;    // pocet cyklu OB30 mezi vzorky → 6×1s = 6s/vzorek
		TestDuration_s : DInt := 1814400;  // max delka testu [s] – timeout vypnut, beha do manualniko stopu
		FlushEveryN : Int := 5;            // pocet vzorku pred flushem: 5=test (30s), 100=produkce (10min)
		AckFlush : Bool;                   // potvrzeni flushe od FB_LogFlushToSd → resetuje FlushPending
	END_VAR

	VAR_OUTPUT
		FlushPending : Bool;       // TRUE = buffer ma dost dat → OB1 ma zapsat na SD
		TestTimeoutReached : Bool; // TRUE = test dosahl TestDuration_s (logika vypnuta)
		CyclesProcessed : DInt;    // pocet OB30 cyklu zpracovanych behem testu
		LastFlushTrigger : USInt;  // co spustilo posledni flush: 1=periodic 2=manual stop 3=timeout
		EdgeStopDetected : Bool;   // prave detekovan StopTest puls (jeden OB30 cyklus)
		EdgeStartDetected : Bool;  // prave detekovan StartTest puls (jeden OB30 cyklus)
	END_VAR

	VAR
		prevStartTest : Bool := FALSE;
		prevStopTest : Bool := FALSE;
		cycleCounter : Int := 0;
		flushCounter : Int := 0;
		StopReason : USInt := 0;  // 0=running, 1=manual stop, 2=timeout, 3=trip/fault
	END_VAR

	VAR_TEMP
		startDtl  : DTL;
		rdRet     : Int;
		yr2       : UInt;
		fName     : String[32];
		digit     : USInt;
	END_VAR

BEGIN
	// Detekce startu testu (hrana)
	EdgeStartDetected := FALSE;
	EdgeStopDetected := FALSE;
	
	IF Enable AND (StartTest AND NOT prevStartTest) THEN
		EdgeStartDetected := TRUE;  // Diagnostika
		"DB_LogRuntime".TestActive := TRUE;
		"DB_LogRuntime".StopSequenceActive := FALSE;
		"DB_LogRuntime".LastStopLogSaved := FALSE;
		"DB_LogRuntime".Elapsed_s := 0.0;
		"DB_LogRuntime".SampleCounter := 0;
		"DB_LogRuntime".FlushErrorCount := 0;
		"DB_LogRuntime".LastFlushOk := FALSE;  // Jeste neprobehl zadny flush
		"DB_LogRuntime".HeaderWritten := FALSE;
		"DB_LogBuffer".TrendWriteIdx := 0;
		"DB_LogBuffer".TrendReadIdx := 0;
		cycleCounter := 0;
		flushCounter := 0;
		FlushPending := FALSE;
		TestTimeoutReached := FALSE;
		CyclesProcessed := 0;  // Reset diagnostiky
		LastFlushTrigger := 0;
		
		// Format initial times for HMI display
		"DB_LogRuntime".ElapsedTime_HMI := '000:00:00';
		"DB_LogRuntime".TargetTime_HMI := "FC_SecondsToTimeString"(seconds := DINT_TO_REAL(TestDuration_s));

		// Generate timestamp-based file name using direct digit manipulation
		rdRet := RD_SYS_T(OUT := startDtl);
		
		// Build filename: LOG_YYMMDD_HHMMSS.csv
		fName := 'LOG_';
		
		// Year (last 2 digits)
		yr2 := startDtl.YEAR MOD 100;
		digit := UINT_TO_USINT(yr2 / 10);
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := UINT_TO_USINT(yr2 MOD 10);
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		// Month
		digit := startDtl.MONTH / 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := startDtl.MONTH MOD 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		// Day
		digit := startDtl.DAY / 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := startDtl.DAY MOD 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		fName := CONCAT(IN1 := fName, IN2 := '_');
		
		// Hour
		digit := startDtl.HOUR / 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := startDtl.HOUR MOD 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		// Minute
		digit := startDtl.MINUTE / 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := startDtl.MINUTE MOD 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		// Second
		digit := startDtl.SECOND / 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		digit := startDtl.SECOND MOD 10;
		fName := CONCAT(IN1 := fName, IN2 := BYTE_TO_CHAR(48 + digit));
		
		fName := CONCAT(IN1 := fName, IN2 := '.csv');
		
		"DB_LogRuntime".FileName := fName;
		"DB_LogRuntime".HeaderWritten := FALSE;
		"DB_LogRuntime".FlushErrorCount := 0;
		"DB_LogRuntime".LastFlushOk := FALSE;  // Jeste neprobehl zadny flush
		"DB_LogRuntime".MaxTempLozisko_C := 0.0;  // Reset max teploty pri startu testu
		"DB_LogRuntime".MaxTempUhliky_C := 0.0;   // Reset max teploty pri startu testu
		StopReason := 0;  // Reset stop reason - test běží
		// (event log: TEST_START)
	END_IF;

	// Detekce stopu testu (hrana)
	IF Enable AND (StopTest AND NOT prevStopTest) THEN
		EdgeStopDetected := TRUE;  // Diagnostika
		"DB_LogRuntime".StopSequenceActive := TRUE;
		"DB_LogRuntime".LastStopLogSaved := FALSE;
		StopReason := 1;  // Manual stop

		// Write final stop record before clearing TestActive so CSV captures stop state
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].t_s := "DB_LogRuntime".Elapsed_s;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RPM := RPM;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Lozisko := T_Lozisko;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Uhliky := T_Uhliky;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].Vibrace := Vibrace;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].ProudUhliky := ProudUhliky;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].State := State;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RunLatched := RunLatched;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripActive := TripActive;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripCode := TripCode;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].SafetyText := SafetyText;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TestActive := FALSE;
		"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].StopReason := StopReason;
		"DB_LogBuffer".TrendWriteIdx := "DB_LogBuffer".TrendWriteIdx + 1;
		IF "DB_LogBuffer".TrendWriteIdx > 999 THEN
			"DB_LogBuffer".TrendWriteIdx := 0;
		END_IF;

		"DB_LogRuntime".TestActive := FALSE;
		FlushPending := TRUE;   // finalni flush pri manuálním stopu
		LastFlushTrigger := 2;  // manual stop flush
		// (event log: TEST_STOP)
	END_IF;

	prevStartTest := StartTest;
	prevStopTest := StopTest;

	// Handshake: FB_LogFlushToSd potvrdil flush -> resetovat FlushPending
	// AckFlush zustane TRUE dokud FlushPending neklesne (4-way handshake)
	IF AckFlush THEN
		FlushPending := FALSE;
		flushCounter := 0;  // Reset counter az PO dokonceni flush-u
	END_IF;

	// Cyklické vzorkování pouze pokud test běží
	IF Enable AND "DB_LogRuntime".TestActive THEN
		cycleCounter := cycleCounter + 1;

		IF cycleCounter >= SampleEveryN_Cycles THEN
			cycleCounter := 0;

			// Cas od startu: kazdy vzorek = SampleEveryN_Cycles * 1s (OB30 period = 1s)
			"DB_LogRuntime".Elapsed_s := "DB_LogRuntime".Elapsed_s
				+ (INT_TO_REAL(SampleEveryN_Cycles) * 1.0);
			
			// Update formatted time strings for HMI display
			"DB_LogRuntime".ElapsedTime_HMI := "FC_SecondsToTimeString"(seconds := "DB_LogRuntime".Elapsed_s);
			
			// Update combined time display (optional - for single field HMI display)
			"DB_LogRuntime".TimeDisplay_HMI := CONCAT(
				IN1 := "DB_LogRuntime".ElapsedTime_HMI,
				IN2 := ' / '
			);
			"DB_LogRuntime".TimeDisplay_HMI := CONCAT(
				IN1 := "DB_LogRuntime".TimeDisplay_HMI,
				IN2 := "DB_LogRuntime".TargetTime_HMI
			);

			// Zapis vzorku do kruhoveho bufferu
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].t_s := "DB_LogRuntime".Elapsed_s;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RPM := RPM;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Lozisko := T_Lozisko;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].T_Uhliky := T_Uhliky;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].Vibrace := Vibrace;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].ProudUhliky := ProudUhliky;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].State := State;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].RunLatched := RunLatched;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripActive := TripActive;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TripCode := TripCode;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].SafetyText := SafetyText;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].TestActive := "DB_LogRuntime".TestActive;
			"DB_LogBuffer".TrendBuffer["DB_LogBuffer".TrendWriteIdx].StopReason := StopReason;

			// Update maximalni teploty behem testu
			IF T_Lozisko > "DB_LogRuntime".MaxTempLozisko_C THEN
				"DB_LogRuntime".MaxTempLozisko_C := T_Lozisko;
			END_IF;
			IF T_Uhliky > "DB_LogRuntime".MaxTempUhliky_C THEN
				"DB_LogRuntime".MaxTempUhliky_C := T_Uhliky;
			END_IF;

			// Posun indexu (kruhový buffer)
			"DB_LogBuffer".TrendWriteIdx := "DB_LogBuffer".TrendWriteIdx + 1;
			IF "DB_LogBuffer".TrendWriteIdx > 999 THEN
				"DB_LogBuffer".TrendWriteIdx := 0;
			END_IF;
			"DB_LogRuntime".SampleCounter := "DB_LogRuntime".SampleCounter + 1;

			// FlushPending: Main vi, ze je cas zapsat na SD
			flushCounter := flushCounter + 1;
			IF flushCounter >= FlushEveryN AND NOT FlushPending THEN
				FlushPending := TRUE;
				LastFlushTrigger := 1;  // periodic flush
			END_IF;
		END_IF;

		// Konec testu po uplynutí času - VYPNUTO (test bezi do nekonecna, az do manualniho stopu)
		// IF "DB_LogRuntime".Elapsed_s >= DINT_TO_REAL(TestDuration_s) THEN
		// 	"DB_LogRuntime".TestActive := FALSE;
		// 	StopReason := 2;  // Timeout
		// 	TestTimeoutReached := TRUE;
		// 	FlushPending := TRUE;   // posledni flush
		// 	LastFlushTrigger := 3;  // timeout flush
		// 	// (event log: TEST_END_TIMEOUT)
		// END_IF;
		
		CyclesProcessed := CyclesProcessed + 1;  // Diagnostika
	END_IF;
END_FUNCTION_BLOCK
TYPE "UDT_SENSORS"
VERSION : 0.1
   STRUCT
      AI1_Teplota_Lozisko_C : Real;
      AI2_Teplota_Kartace_C : Real;
      TM_Rotation_A_Channel : Real;
   END_STRUCT;


END_TYPE

// --- LOGGING UDTs ---
TYPE "UDT_LogRecord"
VERSION : 0.1
	STRUCT
		t_s : Real;
		RPM : Real;
		T_Lozisko : Real;
		T_Uhliky : Real;
		Vibrace : Real;
		ProudUhliky : Real;
		State : USInt;
		RunLatched : Bool;
		TripActive : Bool;
		TripCode : USInt;
		SafetyText : String[40];
		TestActive : Bool;    // TRUE = test běží, FALSE = test byl zastaven
		StopReason : USInt;   // 0=běží, 1=manual stop, 2=timeout, 3=trip/fault
	END_STRUCT;
END_TYPE

TYPE "UDT_EventRecord"
VERSION : 0.1
	STRUCT
		t_s : Real;
		EventCode : USInt;
		EventText : String[32];
		State : USInt;
		TripCode : USInt;
		SafetyText : String[40];
	END_STRUCT;
END_TYPE

FUNCTION "FC_LogRecordToCsv" : String[254]
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT
		Rec : "UDT_LogRecord";
	END_VAR

	VAR_TEMP
		line : String[254];
	END_VAR

BEGIN
	line := REAL_TO_STRING(Rec.t_s);
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := REAL_TO_STRING(Rec.RPM));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := REAL_TO_STRING(Rec.T_Lozisko));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := REAL_TO_STRING(Rec.T_Uhliky));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := REAL_TO_STRING(Rec.Vibrace));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := REAL_TO_STRING(Rec.ProudUhliky));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := USINT_TO_STRING(Rec.State));
	line := CONCAT(IN1 := line, IN2 := ',');

	IF Rec.RunLatched THEN
		line := CONCAT(IN1 := line, IN2 := '1');
	ELSE
		line := CONCAT(IN1 := line, IN2 := '0');
	END_IF;

	line := CONCAT(IN1 := line, IN2 := ',');
	IF Rec.TripActive THEN
		line := CONCAT(IN1 := line, IN2 := '1');
	ELSE
		line := CONCAT(IN1 := line, IN2 := '0');
	END_IF;

	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := USINT_TO_STRING(Rec.TripCode));
	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := Rec.SafetyText);
	line := CONCAT(IN1 := line, IN2 := ',');

	IF Rec.TestActive THEN
		line := CONCAT(IN1 := line, IN2 := '1');
	ELSE
		line := CONCAT(IN1 := line, IN2 := '0');
	END_IF;

	line := CONCAT(IN1 := line, IN2 := ',');
	line := CONCAT(IN1 := line, IN2 := USINT_TO_STRING(Rec.StopReason));

	#FC_LogRecordToCsv := #line;
END_FUNCTION

DATA_BLOCK "DB_LogConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		Enable : Bool;             // TRUE = logovani povoleno (default TRUE)
		StartTest : Bool;          // HMI/WebAPI: nastav TRUE pro start testu (hrana, auto-reset OB30)
		StopTest : Bool;           // HMI/WebAPI: nastav TRUE pro manual stop testu (hrana, auto-reset OB30)
		TestDuration_s : DInt;     // max delka testu [s] – default 1814400 = 3 tydny
		FlushEveryN : Int;         // flush kazdych N vzorku – default 5 (30s), prod 100 (10min)
		FilePrefix : String[16];   // rezerva pro pojmenovani souboru (zatim nevyuzito)
	END_VAR
BEGIN
	Enable := TRUE;
	StartTest := false;
	StopTest := false;
	TestDuration_s := 1814400;  // 3 tydny = 21 dni = 504 hodin
	FlushEveryN := 5;  // TESTOVACI NASTAVENI (prod: 100)
	FilePrefix := 'testlog';
END_DATA_BLOCK

DATA_BLOCK "DB_LogRuntime"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
	VAR
		TestActive : Bool;             // TRUE = test probiha (sleduj pro zahajeni mereni)
		TestActivePrev : Bool;         // predchozi stav TestActive pro edge logiku v OB1
		StartReqLatched : Bool;        // OB1 latch StartTest pulsu (ochrana proti ztrate hrany pri OB30=1000ms)
		StopReqLatched : Bool;         // OB1 latch StopTest pulsu (ochrana proti ztrate hrany pri OB30=1000ms)
		StopSequenceActive : Bool;     // TRUE = probiha stop sekvence a ceka se na final flush
		LastStopLogSaved : Bool;       // TRUE = posledni stop dokoncil flush na SD (indikace pro HMI)
		TestStartTs : Date_And_Time;   // cas startu testu (RD_SYS_T pri StartTest hrane)
		Elapsed_s : Real;              // uplynuly cas od startu testu [s], aktualizuje se kazdych 6s
		SampleCounter : DInt;          // celkovy pocet vzorku zapsanych do bufferu od startu
		LastFlushOk : Bool;            // TRUE = posledni flush na SD probehl bez chyby
		LastError : String[40];        // text posledni chyby flushe (FileWriteC status kod)
		FileName : String[32];         // nazev aktualniho log souboru (LOG_YYMMDD_HHMMSS.csv)
		HeaderWritten : Bool;          // TRUE = CSV hlavicka uz zapsana do souboru
		FlushErrorCount : Int;         // pocet chyb flushe od posledniho startu (alarm >0)
		// HMI display strings (formatted time)
		ElapsedTime_HMI : String[9];   // HMI zobrazeni uplynuteho casu "HHH:MM:SS" (max 999h)
		TargetTime_HMI : String[9];    // HMI zobrazeni ciloveho casu "HHH:MM:SS"
		TimeDisplay_HMI : String[21];  // HMI jedno pole: "HHH:MM:SS / HHH:MM:SS"
		// Maximalni teploty behem testu
		MaxTempLozisko_C : Real;       // max teplota loziska od startu testu [degC]
		MaxTempUhliky_C : Real;        // max teplota uhliku/kartacu od startu testu [degC]
		// OB30 cycle time monitoring
		OB30_LastTs : DTL;             // posledni cas zacatku OB30 cyklu
		OB30_CycleTime_ms : Int;       // delka aktualniho OB30 cyklu [ms]
		OB30_MaxCycleTime_ms : Int;    // maximum vzorkovany cyklus [ms]
		OB30_MinCycleTime_ms : Int;    // minimum vzorkovany cyklus [ms] (init 1000)
		OB30_CycleCounter : DInt;      // pocet OB30 cyklu od startu testu (kazdych 1s by se zvysil o 1)
	END_VAR
BEGIN
	TestActive := false;
	TestActivePrev := false;
	StartReqLatched := false;
	StopReqLatched := false;
	StopSequenceActive := false;
	LastStopLogSaved := false;
	Elapsed_s := 0.0;
	SampleCounter := 0;
	LastFlushOk := false;  // Jeste neprobehl zadny flush
	LastError := '';
	FileName := '';
	HeaderWritten := false;
	FlushErrorCount := 0;
	ElapsedTime_HMI := '000:00:00';
	TargetTime_HMI := '000:00:00';
	TimeDisplay_HMI := '000:00:00 / 000:00:00';
	MaxTempLozisko_C := 0.0;
	MaxTempUhliky_C := 0.0;
	OB30_CycleTime_ms := 0;
	OB30_MaxCycleTime_ms := 0;
	OB30_MinCycleTime_ms := 1000;
	OB30_CycleCounter := 0;
END_DATA_BLOCK

DATA_BLOCK "DB_LogBuffer"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		TrendBuffer : ARRAY[0..999] OF "UDT_LogRecord";   // kruhovy buffer vzorku (1000 polozek × 6s = 100 min)
		EventBuffer : ARRAY[0..99] OF "UDT_EventRecord";  // buffer eventu (faze 3)
		TrendWriteIdx : Int;   // index zapisu (LogManager) – sleduj pro debug plneni bufferu
		TrendReadIdx : Int;    // index cteni/flushe (LogFlushToSd) – WriteIdx-ReadIdx = neprectenych radku
		EventWriteIdx : Int;   // index zapisu eventu
		EventReadIdx : Int;    // index cteni eventu
	END_VAR
BEGIN
	TrendWriteIdx := 0;
	TrendReadIdx := 0;
	EventWriteIdx := 0;
	EventReadIdx := 0;
END_DATA_BLOCK

DATA_BLOCK "DB_HMI"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Sensors { S7_SetPoint := 'False'} : "UDT_SENSORS";   // AI hodnoty po prepoctu (teploty degC, RPM)
      System : Struct
         Enable : Bool;   // rezerva pro systemove povoleni
      END_STRUCT;
      Spindle : Struct
         Start : Bool;    // HMI puls start vretene (auto-reset v OB1)
         Stop : Bool;     // HMI puls stop vretene (auto-reset v OB1)
         ResetFault : Bool;  // HMI puls reset chyby meniče
         Speed_RPM : Real;   // zadane otacky vretene [RPM] – max 18000
         Enable : Bool;      // rezerva
      END_STRUCT;
      LabPSU : Struct
         Enable : Bool;            // povoleni laboratorniho zdroje (auto-set pri StartTest)
			Cycle_s : Real;           // perioda OB30 [s] – default 1.0
			Mode : USInt;             // rezim zdroje: 0=OFF 1=CONST 2=SINE_DEBUG
			BaseVoltage_V : Real;     // napeti zdroje [V] – default 2.0
			DebugAmplitude_A : Real;  // amplituda sinusoidy [A] – default 5.0
			DebugPeriod_min : Real;   // perioda sinusoidy [min] – default 1.0 min
			CurrentOffset_A : Real;   // deprecated: v SINE_DEBUG se nepouziva
			ConstCurrent_A : Real;    // proud v CONST rezimu [A] – default 10.0
			MaxCurrent_A : Real;      // maximalni povoleny proud [A] – default 38.0
			CurrentLimitExceeded : Bool;  // TRUE = zadany proud prekrocil MaxCurrent_A
			SineCycleCounter : UDInt;     // pocet dokoncenych period sinusoidy od startu
      END_STRUCT;
   END_VAR


BEGIN
	LabPSU.Enable := false;
	LabPSU.Cycle_s := 1.0;  // OB30 = 1000ms = 1s
	LabPSU.Mode := 2;  // 2 = SINE_DEBUG (sinusova modulace)
	LabPSU.BaseVoltage_V := 2.0;
	LabPSU.DebugAmplitude_A := 5.0;
	LabPSU.DebugPeriod_min := 1.0;  // 1 minuta perioda
	LabPSU.CurrentOffset_A := 5.0;
	LabPSU.ConstCurrent_A := 10.0;  // 10 A pro CONST rezim
	LabPSU.MaxCurrent_A := 38.0;
	LabPSU.CurrentLimitExceeded := false;
	LabPSU.SineCycleCounter := 0;

END_DATA_BLOCK

