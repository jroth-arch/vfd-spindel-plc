FUNCTION_BLOCK "FB_LogFlushToSd"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
	VAR_INPUT
		Enable : Bool;
		FlushRequest : Bool;       // z LogManager.FlushPending
		FinalFlush : Bool;         // TRUE = zapsat vse (pri stopu/timeoutu)
		MaxRowsPerFlush : Int := 50;
		RetryLimit : Int := 3;
	END_VAR

	VAR_OUTPUT
		Busy : Bool;
		AckFlush : Bool;           // 1 cyklus TRUE po dokonceni
		Error : Bool;
		ErrorCode : Word;
	END_VAR

	VAR
		Step : USInt;
		RowIdx : Int;
		RowsToFlush : Int;
		RowsDone : Int;
		RetryCount : Int;
		prevFlushReq : Bool;
	END_VAR

	VAR_TEMP
		rowsAvail : Int;
	END_VAR

	VAR CONSTANT
		STEP_IDLE : USInt := 0;
		STEP_PREPARE : USInt := 1;
		STEP_OPEN : USInt := 2;
		STEP_WR_HEADER : USInt := 3;
		STEP_WR_ROW : USInt := 4;
		STEP_NEXT_ROW : USInt := 5;
		STEP_CLOSE : USInt := 6;
		STEP_ACK : USInt := 7;
		STEP_ERROR : USInt := 10;
	END_VAR

BEGIN
	AckFlush := FALSE;
	Busy := FALSE;
	Error := FALSE;
	ErrorCode := 0;

	CASE Step OF
		STEP_IDLE:
			IF Enable AND (FlushRequest AND NOT prevFlushReq) THEN
				Busy := TRUE;
				Step := STEP_PREPARE;
			END_IF;

		STEP_PREPARE:
			IF "DB_LogBuffer".TrendWriteIdx >= "DB_LogBuffer".TrendReadIdx THEN
				rowsAvail := "DB_LogBuffer".TrendWriteIdx - "DB_LogBuffer".TrendReadIdx;
			ELSE
				rowsAvail := (1000 - "DB_LogBuffer".TrendReadIdx) + "DB_LogBuffer".TrendWriteIdx;
			END_IF;

			IF FinalFlush THEN
				RowsToFlush := rowsAvail;
			ELSE
				RowsToFlush := rowsAvail;
				IF RowsToFlush > MaxRowsPerFlush THEN
					RowsToFlush := MaxRowsPerFlush;
				END_IF;
			END_IF;

			IF RowsToFlush <= 0 THEN
				Step := STEP_ACK;
			ELSE
				RowIdx := "DB_LogBuffer".TrendReadIdx;
				RowsDone := 0;
				RetryCount := 0;
				Step := STEP_OPEN;
			END_IF;

		STEP_OPEN:
			// TODO: FileOpen APPEND na "DB_LogRuntime".FileName
			IF "DB_LogRuntime".HeaderWritten THEN
				Step := STEP_WR_ROW;
			ELSE
				Step := STEP_WR_HEADER;
			END_IF;

		STEP_WR_HEADER:
			// TODO: FileWrite CSV hlavicky
			"DB_LogRuntime".HeaderWritten := TRUE;
			Step := STEP_WR_ROW;

		STEP_WR_ROW:
			// TODO: FileWrite jednoho radku z TrendBuffer[RowIdx]
			Step := STEP_NEXT_ROW;

		STEP_NEXT_ROW:
			RowsDone := RowsDone + 1;
			RowIdx := RowIdx + 1;
			IF RowIdx >= 1000 THEN
				RowIdx := 0;
			END_IF;

			IF RowsDone >= RowsToFlush THEN
				Step := STEP_CLOSE;
			ELSE
				Step := STEP_WR_ROW;
			END_IF;

		STEP_CLOSE:
			// TODO: FileClose
			Step := STEP_ACK;

		STEP_ACK:
			"DB_LogBuffer".TrendReadIdx := "DB_LogBuffer".TrendReadIdx + RowsDone;
			IF "DB_LogBuffer".TrendReadIdx >= 1000 THEN
				"DB_LogBuffer".TrendReadIdx := "DB_LogBuffer".TrendReadIdx - 1000;
			END_IF;
			"DB_LogRuntime".LastFlushOk := TRUE;
			AckFlush := TRUE;
			Busy := FALSE;
			Step := STEP_IDLE;

		STEP_ERROR:
			"DB_LogRuntime".LastFlushOk := FALSE;
			"DB_LogRuntime".FlushErrorCount := "DB_LogRuntime".FlushErrorCount + 1;
			RetryCount := RetryCount + 1;
			IF RetryCount <= RetryLimit THEN
				Step := STEP_OPEN;
			ELSE
				Error := TRUE;
				Busy := FALSE;
				AckFlush := TRUE;
				Step := STEP_IDLE;
			END_IF;
	END_CASE;

	prevFlushReq := FlushRequest;
END_FUNCTION_BLOCK

