DATA_BLOCK "DB_LogConfig"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		Enable : Bool;
		StartTest : Bool;   // nastavit true pres HMI/Web API pro spusteni testu (hrana)
		StopTest : Bool;    // nastavit true pres HMI/Web API pro zastaveni testu (hrana)
		SampleTime_ms : Int;
		TestDuration_s : DInt;
		FlushEveryN : Int;
		FilePrefix : String[16];
	END_VAR
BEGIN
	Enable := false;
	StartTest := false;
	StopTest := false;
	SampleTime_ms := 200;
	TestDuration_s := 86400;
	FlushEveryN := 100;
	FilePrefix := 'testlog';
END_DATA_BLOCK

DATA_BLOCK "DB_LogRuntime"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
	VAR
		TestActive : Bool;
		TestStartTs : Date_And_Time;
		Elapsed_s : Real;
		SampleCounter : DInt;
		LastFlushOk : Bool;
		LastError : String[40];
		FileName : String[32];        // generovano pri startu testu: YYYYMMDD-HHMMSS.csv
		HeaderWritten : Bool;         // TRUE = CSV hlavicka jiz zapsana do aktualniho souboru
		FlushErrorCount : Int;        // pocet chyb flushe od posledniho startu testu
	END_VAR
BEGIN
	TestActive := false;
	Elapsed_s := 0.0;
	SampleCounter := 0;
	LastFlushOk := true;
	LastError := '';
	FileName := '';
	HeaderWritten := false;
	FlushErrorCount := 0;
END_DATA_BLOCK

